# Copy to .env and adjust.
OPENAI_API_KEY=your_openai_api_key
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bldr
EXA_API_KEY=your_exa_api_key
# Optional: allow TLS-cert bypass fallback for Exa/direct website fetch in non-standard local networks.
# Keep false in production.
EXA_ALLOW_INSECURE_TLS=false